<!DOCTYPE html>
<html lang="en">
  <%- include("partials/head", { title: "URL Shortener" }) %>
  <body class="bg-black text-white min-h-screen flex flex-col items-center justify-start p-8">
    <div class="w-full flex justify-between items-center mb-8 max-w-4xl">
      <h1 class="text-3xl font-bold text-center">URL Shortener</h1>
      <div class="flex gap-4">
        <!-- Delete All URLs -->
        <form action="/api/v1/short" method="DELETE">
          <button 
            type="submit"
            class="px-4 py-2 bg-red-600 hover:bg-red-700 rounded font-semibold text-sm transition-colors"
          >
            Delete All
          </button>
        </form>

        <!-- Logout -->
        <form action="http://localhost:5500/signout" method="POST">
          <button 
            type="submit"
            class="px-4 py-2 bg-gray-700 hover:bg-gray-800 rounded font-semibold text-sm transition-colors"
          >
            Log Out
          </button>
        </form>
      </div>
    </div>

    <!-- Shorten Form -->
    <form 
      action="/api/v1/short" 
      method="POST" 
      class="w-full max-w-lg bg-gray-900 p-6 rounded-2xl shadow-lg mb-8"
    >
      <label class="block mb-2 text-sm font-medium text-gray-300">
        Enter a long URL
      </label>
      <input 
        type="url" 
        name="originalUrl" 
        required 
        placeholder="https://example.com/very/long/link"
        class="w-full p-2 mb-4 rounded bg-gray-800 border border-gray-700 focus:outline-none focus:border-purple-500"
      />
      <button 
        type="submit"
        class="w-full py-2 bg-purple-600 hover:bg-purple-700 rounded font-semibold transition-colors"
      >
        Shorten URL
      </button>
    </form>

    <!-- URL List -->
    <% if (urls && urls.length > 0) { %>
      <div class="w-full max-w-2xl bg-gray-900 p-6 rounded-2xl shadow-lg">
        <h2 class="text-xl font-semibold mb-4">Your Shortened Links</h2>
        <ul class="space-y-3">
          <% urls.forEach(link => { %>
            <li class="flex justify-between items-center bg-gray-800 p-3 rounded">
              <div class="flex flex-col">
                <a href="<%= link.originalUrl %>" target="_blank" class="text-sm text-gray-400 truncate">
                  <%= link.originalUrl %>
                </a>
                <a href="/<%= link.shortUrl %>" target="_blank" class="text-purple-400 font-semibold">
                  <%= requestHost %>/<%= link.shortUrl %>
                </a>
              </div>
              <button 
                onclick="navigator.clipboard.writeText('<%= requestHost %>/<%= link.shortUrl %>')" 
                class="text-xs px-3 py-1 bg-purple-700 hover:bg-purple-800 rounded"
              >
                Copy
              </button>
            </li>
          <% }) %>
        </ul>
      </div>
    <% } else { %>
      <p class="text-gray-500 text-sm text-center mt-4">No shortened links yet.</p>
    <% } %>
  </body>
</html>

