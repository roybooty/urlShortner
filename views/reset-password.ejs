<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script src="https://cdn.tailwindcss.com"></script>
    <title>Reset Password</title>
  </head>
  <body class="bg-black flex items-center justify-center h-screen text-white">
    <form action="https://safwan-ulob.onrender.com/api/v1/reset-password" method="POST" class="bg-gray-900 p-8 rounded-2xl w-96 shadow-lg">
      <h1 class="text-2xl font-bold mb-6 text-center">Reset Password</h1>
      <% if (message) { %>
        <p class="text-red-400 text-sm mb-4"><%= message %></p>
      <% } %>
      <input type="hidden" name="token" value="<%= token %>" />
      <input
        type="password"
        name="password"
        placeholder="New Password"
        class="w-full p-3 rounded bg-gray-800 text-white focus:outline-none mb-4"
        required
      />
       <input
        type="password"
        name="confirm"
        placeholder="Confirm Password"
        class="w-full p-3 rounded bg-gray-800 text-white focus:outline-none mb-4"
        required
      />
      <button class="w-full bg-indigo-600 hover:bg-indigo-700 p-3 rounded font-semibold">Reset Password</button>
    </form>
  </body>
</html>

