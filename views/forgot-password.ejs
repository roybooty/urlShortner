<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script src="https://cdn.tailwindcss.com"></script>
    <title>Forgot Password</title>
  </head>
  <body class="bg-black flex items-center justify-center h-screen text-white">
    <form action="http://localhost:5500/api/v1/forgot-password" method="POST" class="bg-gray-900 p-8 rounded-2xl w-96 shadow-lg">
      <h1 class="text-2xl font-bold mb-6 text-center">Forgot Password</h1>
      <% if (message) { %>
        <p class="text-red-400 text-sm mb-4"><%= message %></p>
      <% } %>
      <input
        type="email"
        name="email"
        placeholder="Enter your email"
        class="w-full p-3 rounded bg-gray-800 text-white focus:outline-none mb-4"
        required
      />
      <button class="w-full bg-indigo-600 hover:bg-indigo-700 p-3 rounded font-semibold">Send OTP</button>
    </form>
  </body>
</html>

